<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Build-time progressive AVIF image optimization for Razor applications using libavif.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Gen.Razor.ImageOptimizer.Avif</AssemblyName>
        <PackageId>Soenneker.Gen.Razor.ImageOptimizer.Avif</PackageId>
        <PackageTags>gen razor imageoptimizer avif generator image optimizer progressive libavif externalgenerator imageoptimizeravif</PackageTags>
        <Copyright>Copyright Ã‚Â© 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.gen.razor.imageoptimizer.avif</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.gen.razor.imageoptimizer.avif</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Gen.Razor.ImageOptimizer.Avif.targets" Pack="true" PackagePath="build/" />
        <None Include="Soenneker.Gen.Razor.ImageOptimizer.Avif.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <ImageOptimizerAvifNativeRuntimeIdentifier Condition="'$(ImageOptimizerAvifNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ImageOptimizerAvifNativeRuntimeIdentifier>
        <ImageOptimizerAvifNativeArtifactsDir Condition="'$(ImageOptimizerAvifNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</ImageOptimizerAvifNativeArtifactsDir>
        <_ImageOptimizerAvifNativeExecutable>Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks</_ImageOptimizerAvifNativeExecutable>
        <_ImageOptimizerAvifNativeExecutable Condition="$([System.String]::Copy('$(ImageOptimizerAvifNativeRuntimeIdentifier)').StartsWith('win-'))">$(_ImageOptimizerAvifNativeExecutable).exe</_ImageOptimizerAvifNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(ImageOptimizerAvifUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(ImageOptimizerAvifNativeSource);../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/obj/project.assets.json"
            Outputs="$(ImageOptimizerAvifNativeArtifactsDir)/$(ImageOptimizerAvifNativeRuntimeIdentifier)/$(_ImageOptimizerAvifNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks.csproj&quot; --configuration Release --runtime $(ImageOptimizerAvifNativeRuntimeIdentifier) --output &quot;$(ImageOptimizerAvifNativeArtifactsDir)/$(ImageOptimizerAvifNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <ImageOptimizerAvifNativeSource Include="../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/**/*.cs;../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/bin/**;../Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_ImageOptimizerAvifRequiredRuntime Include="win-x64;linux-x64" Condition="'$(ImageOptimizerAvifUsePrebuiltNativeTools)' == 'true'" />
            <_ImageOptimizerAvifNativeFile Include="$(ImageOptimizerAvifNativeArtifactsDir)/**/*"
                                Exclude="$(ImageOptimizerAvifNativeArtifactsDir)/win-x64/Resources/linux-x64/**;$(ImageOptimizerAvifNativeArtifactsDir)/linux-x64/Resources/win-x64/**;$(ImageOptimizerAvifNativeArtifactsDir)/**/*.pdb;$(ImageOptimizerAvifNativeArtifactsDir)/**/*.dbg;$(ImageOptimizerAvifNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_ImageOptimizerAvifNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_ImageOptimizerAvifRequiredRuntime)' != '' and !Exists('$(ImageOptimizerAvifNativeArtifactsDir)/%(_ImageOptimizerAvifRequiredRuntime.Identity)/Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks') and !Exists('$(ImageOptimizerAvifNativeArtifactsDir)/%(_ImageOptimizerAvifRequiredRuntime.Identity)/Soenneker.Gen.Razor.ImageOptimizer.Avif.BuildTasks.exe')"
               Text="Missing native imageoptimizer.avif tool for %(_ImageOptimizerAvifRequiredRuntime.Identity)." />
        <Error Condition="'@(_ImageOptimizerAvifNativeFile)' == ''" Text="Native imageoptimizer.avif tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
